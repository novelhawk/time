{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "time",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "time.novelhawk.dev",
      "custom_domain": true,
      "previews_enabled": true
    }
  ],
  "previews": {}
}
