{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "time",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "time.novelhawk.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_VERSION": "26",
    "PNPM_VERSION": "12.16.1",
  },
}
